rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupDoc(grupoId) {
      return get(/databases/$(database)/documents/grupos/$(grupoId));
    }

    function isGroupMember(grupoId) {
      return signedIn()
        && grupoId is string
        && exists(/databases/$(database)/documents/grupos/$(grupoId))
        && request.auth.uid in groupDoc(grupoId).data.miembros;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function myGroupId() {
      return signedIn() && myUserDoc().exists() ? myUserDoc().data.grupoId : null;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (
          resource.data.grupoId is string
          && isGroupMember(resource.data.grupoId)
        )
      );

      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /grupos/{grupoId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.miembrosCount == 1
        && request.auth.uid in request.resource.data.miembros;

      allow update: if signedIn() && (
        request.auth.uid in resource.data.miembros
        || (
          request.auth.uid in request.resource.data.miembros
          && request.resource.data.miembrosCount <= request.resource.data.maxMiembros
          && request.resource.data.miembrosCount <= 2
        )
      );

      allow delete: if signedIn() && request.auth.uid in resource.data.miembros;

      match /gastos/{gastoId} {
        allow read, write: if isGroupMember(grupoId);
      }

      match /listaCompra/{itemId} {
        allow read, write: if isGroupMember(grupoId);
      }

      match /eventos/{eventoId} {
        allow read, write: if isGroupMember(grupoId);
      }

      match /liquidaciones/{liqId} {
        allow read, write: if isGroupMember(grupoId);
      }

      match /config/{docId} {
        allow read, write: if isGroupMember(grupoId);
      }
    }

    match /pushTokens/{token} {
      allow read: if false;

      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
